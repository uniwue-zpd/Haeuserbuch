# Copy to .env.prod and replace every placeholder before starting production.
COMPOSE_PROJECT_NAME=haeuserbuch-prod

DB_NAME=haeuserbuch
DB_USER=haeuserbuch
DB_PASSWORD=replace-with-a-long-random-password

# Set to true only for the first deployment against the legacy database.
# Change back to false after Flyway has recorded baseline V1 and applied V2.
FLYWAY_BASELINE_ON_MIGRATE=false

# The frontend is intended to sit behind Apache and therefore binds to loopback.
BIND_IP=127.0.0.1
FRONTEND_PORT=3000

# Multi-architecture PostGIS image (AMD64 and ARM64).
POSTGIS_IMAGE=imresamu/postgis:17-3.5-alpine
TILESERVER_IMAGE=maptiler/tileserver-gl:v5.4.0
TILES_DIR=./tiles

# Local image defaults used with compose.prod.build.yaml. For deployments using
# published images, replace these with ghcr.io references and omit the build overlay.
HAEUSERBUCH_BACKEND_IMAGE=haeuserbuch-backend:local
HAEUSERBUCH_FRONTEND_IMAGE=haeuserbuch-frontend:local
HAEUSERBUCH_BACKUP_IMAGE=haeuserbuch-db-backup:local

# Used only when the optional backup profile is enabled.
BACKUP_DIR=./backups

# Auth
KEYCLOAK_ISSUER_URI=
NUXT_OAUTH_KEYCLOAK_SERVER_URL=
NUXT_OAUTH_KEYCLOAK_REDIRECT_URL=
NUXT_OAUTH_KEYCLOAK_REALM=
NUXT_OAUTH_KEYCLOAK_CLIENT_ID=
NUXT_OAUTH_KEYCLOAK_CLIENT_SECRET=
NUXT_SESSION_PASSWORD=
