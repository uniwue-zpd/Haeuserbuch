# Optional development overrides. The development stack also runs without this file.
COMPOSE_PROJECT_NAME=haeuserbuch

DB_NAME=haeuserbuch
DB_USER=haeuserbuch
DB_PASSWORD=haeuserbuch_dev_password

# Only Nuxt is published to the host.
FRONTEND_PORT=3000

# Multi-architecture defaults for Apple Silicon and AMD64 development machines.
POSTGIS_IMAGE=imresamu/postgis:17-3.5-alpine
TILESERVER_IMAGE=maptiler/tileserver-gl:v5.4.0
TILES_DIR=./tiles

# Polling is more reliable for Docker Desktop bind mounts.
CHOKIDAR_USEPOLLING=true
