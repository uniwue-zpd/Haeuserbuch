<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- Define a simple type for non-empty strings -->
  <xs:simpleType name="nonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Define a simple type for non-negative values fitting into a Long -->
  <xs:simpleType name="nonNegativeLong">
    <xs:restriction base="xs:long">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Define an attribute group for the BaseEntity attributes -->
  <!-- Dates are written by the backend as epoch milliseconds -->
  <xs:attributeGroup name="baseEntityAttributes">
    <xs:attribute name="id" type="xs:long"/>
    <xs:attribute name="createdDate" type="xs:long"/>
    <xs:attribute name="createdBy" type="xs:string"/>
    <xs:attribute name="lastModifiedDate" type="xs:long"/>
    <xs:attribute name="lastModifiedBy" type="xs:string"/>
  </xs:attributeGroup>

  <!-- The complex type for a single "distriktBesitzNummer" (=district property number) element -->
  <xs:complexType name="distriktBesitzNummerTyp">
    <xs:simpleContent>
      <xs:extension base="nonEmptyString">
        <xs:attribute name="gebaeudeId" type="xs:long">
          <xs:annotation>
            <xs:documentation>ID des zugeordneten Gebäudes, wird beim Speichern vom Backend gesetzt</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- The complex type for the "distriktBesitzNummern" wrapper element -->
  <!-- Free text between the numbers is allowed, e.g. "nun" -->
  <xs:complexType name="distriktBesitzNummernTyp" mixed="true">
    <!-- The element may occur one or more times -->
    <xs:sequence>
      <xs:element
        name="distriktBesitzNummer"
        type="distriktBesitzNummerTyp"
        maxOccurs="unbounded"
      >
        <xs:annotation>
          <xs:documentation>Distriktbesitznummer des Gebäudes, z.B. II/434</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- The complex type for a single "name" (=building name) element -->
  <xs:complexType name="nameTyp">
    <xs:simpleContent>
      <xs:extension base="nonEmptyString">
        <xs:attribute name="quelleId" type="xs:long">
          <xs:annotation>
            <xs:documentation>ID der Quelle des Gebäudenamens</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- The complex type for the "namen" wrapper element -->
  <!-- Free text between the names is allowed -->
  <xs:complexType name="namenTyp" mixed="true">
    <!-- The element may occur one or more times -->
    <xs:sequence>
      <xs:element
        name="name"
        type="nameTyp"
        maxOccurs="unbounded"
      >
        <xs:annotation>
          <xs:documentation>Name des Gebäudes</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- The complex type for the "haus" (=building) element -->
  <!-- Free text between the elements is allowed -->
  <xs:complexType name="hausTyp" mixed="true">
    <xs:sequence>
      <xs:element
        name="distriktBesitzNummern"
        type="distriktBesitzNummernTyp"
      >
        <xs:annotation>
          <xs:documentation>Distriktbesitznummern der zugehörigen Gebäude</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element
        name="namen"
        type="namenTyp"
        minOccurs="0"
      >
        <xs:annotation>
          <xs:documentation>Namen des Gebäudes</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element
        name="summe"
        type="nonNegativeLong"
        minOccurs="0"
      >
        <xs:annotation>
          <xs:documentation>Die Angabe der Summe</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- The root element of the schema (=entry) -->
  <xs:element name="eintrag">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element
          name="signatur"
          type="nonEmptyString"
          minOccurs="0"
        >
          <xs:annotation>
            <xs:documentation>Archivalische Signatur inklusive Folio-Angabe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element
          name="haus"
          type="hausTyp"
          minOccurs="0"
        />
      </xs:sequence>
      <xs:attributeGroup ref="baseEntityAttributes"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
