FROM maven:3.9.16-amazoncorretto-21 AS build

WORKDIR /app

COPY pom.xml ./
RUN mvn --batch-mode dependency:go-offline -DskipTests

COPY src ./src
RUN mvn --batch-mode clean package -DskipTests


FROM eclipse-temurin:21-jre-alpine

LABEL description="Production image for the Haeuserbuch Spring Boot backend"

RUN apk add --no-cache curl \
    && addgroup -S app \
    && adduser -S -G app app \
    && mkdir -p /uploads \
    && chown app:app /uploads

WORKDIR /app

COPY --from=build --chown=app:app /app/target/haeuserbuch_backend-0.0.1-SNAPSHOT.jar /app/app.jar

USER app

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
